# ==============================================================================
# Nexora - environment variables
#
# Copy this file to .env and adjust. docker-compose.yml reads these and every
# service reads its config from environment variables only (12-factor style).
# Every variable has a safe default baked into docker-compose.yml, so an empty
# .env (or no .env at all) works for local development out of the box.
#
# For Render deployment, render.yaml wires almost all of this automatically
# (env var groups + fromService/fromDatabase references). Only the external
# credentials marked [EXTERNAL] below must be pasted in the Render Dashboard
# after the first deploy. See DEPLOY_RENDER.md for the full walkthrough.
# ==============================================================================

# ---------- Infrastructure (consumed by docker-compose containers) ----------
NODE_ENV=development

# Per-service identity - set individually in docker-compose.yml / render.yaml,
# never in .env (every service would collide). Commented here for reference:
# PORT=3000
# SERVICE_NAME=api-gateway

# Test-only override for the websocket-gateway scaling test (ws.test.js):
# INSTANCE_2_URL=ws://localhost:3009/ws

# Postgres server credentials (creates the local container user/db)
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora
POSTGRES_DB=nexora
POSTGRES_PORT=5432

REDIS_PORT=6379

KAFKA_PORT=9092
# Kafka topics created on startup by the kafka-init sidecar
KAFKA_MESSAGE_EVENTS_TOPIC=message-events
KAFKA_MESSAGE_EVENTS_PARTITIONS=3
KAFKA_DELIVERED_TOPIC=chat.message.delivered
KAFKA_READ_TOPIC=chat.message.read
KAFKA_DLQ_TOPIC=message-events-dlq

# MinIO server root credentials (MINIO_ACCESS_KEY/SECRET_KEY map to these)
MINIO_PORT=9000
MINIO_ROOT_USER=nexora
MINIO_ROOT_PASSWORD=nexora-minio-secret

# ---------- Shared (read by every service; same values across the mesh) -------
# Internal connection strings (container DNS names). On Render these are
# injected automatically from the managed Postgres/Redis.
DATABASE_URL=postgres://nexora:nexora@postgres:5432/nexora
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:9092

# Shared internal secret between api-gateway and downstream services
SERVICE_SECRET=dev-internal-secret

# Auth / JWT secrets
JWT_ACCESS_SECRET=dev-only-access-secret
JWT_REFRESH_SECRET=dev-only-refresh-secret
BCRYPT_ROUNDS=10

# ---------- api-gateway ----------
# Internal service URLs. On Render these are injected via fromService hostport
# (bare "host:port"); api-gateway's config.js adds the scheme automatically.
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
GROUP_SERVICE_URL=http://group-service:3003
CHAT_SERVICE_URL=http://chat-service:3004
MEDIA_SERVICE_URL=http://media-service:3010
GATEWAY_HTTP_URL=http://websocket-gateway:3008
# Comma-separated WS gateway instances the api-gateway round-robins upgrades
# across. When scaling with --scale, point at replica DNS names:
# ws://websocket-gateway-1:3008,ws://websocket-gateway-2:3008,...
WS_GATEWAY_URLS=ws://websocket-gateway:3008,ws://websocket-gateway-2:3009

# ---------- auth-service ----------
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- chat-service ----------
# KAFKA_CLIENT_ID defaults per service (nexora-chat-service /
# nexora-delivery-service / nexora-notification-service) baked into compose +
# config.js, so it is intentionally NOT set here - one .env value would collide
# across services:
# KAFKA_CLIENT_ID=nexora-chat-service

# ---------- delivery-service ----------
DELIVERY_RECEIPT_CHANNEL=delivery:receipts
PRESENCE_KEY_PREFIX=presence:
DLQ_MAX_ATTEMPTS=5
DLQ_BASE_DELAY_MS=1000
DLQ_JITTER_MAX_MS=500
# Consumer group id; defaults to nexora-delivery-service / nexora-notification-
# service per service. Only set this if you deliberately want both consumers in
# ONE group (message load-splitting):
# KAFKA_MESSAGE_EVENTS_GROUP=nexora-delivery-service

# ---------- notification-service ----------
# (no extra vars; kafka client id + consumer group default per service)

# ---------- websocket-gateway ----------
PRESENCE_TTL_SECONDS=90
PRESENCE_GRACE_SECONDS=30
WS_HEARTBEAT_TIMEOUT_MS=90000
WS_HEARTBEAT_CHECK_INTERVAL_MS=30000
WS_PATH=/ws

# ---------- media-service (S3-compatible object storage) ----------
# Internal endpoint is how media-service reaches the store; the public endpoint
# is the browser-reachable host embedded in presigned URLs (localhost works for
# the demo; point it at the machine's LAN IP to test from another device).
MINIO_INTERNAL_ENDPOINT=minio
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=nexora
MINIO_SECRET_KEY=nexora-minio-secret
MINIO_BUCKET=nexora-media

# ---------- Cloud Kafka [EXTERNAL - Render only] ------------------------------
# Set these when connecting to a cloud Kafka broker (Upstash/Confluent) instead
# of the local container. When KAFKA_SASL_USERNAME is set, kafkajs enables
# SASL + TLS automatically. On Render this lives in the nexora-kafka env group.
# KAFKA_BROKERS=kafka-1.upstash.io:9092
# KAFKA_SASL_MECHANISM=scram-sha-256
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL=true

# ---------- Frontend (Vite build-time env var) --------------------------------
# Set this when the frontend calls the api-gateway from a DIFFERENT origin.
# When empty (default), the SPA uses relative /api + /ws paths, which work with
# Vite's dev proxy locally and are proxied to the gateway by nginx in the
# Docker image / on Render.
# VITE_API_BASE_URL=https://api-gateway-xxxx.onrender.com
# nginx upstream for relative-path mode. docker-compose defaults to the compose
# service DNS; Render sets it via fromService hostport on nexora-frontend.
# API_GATEWAY_UPSTREAM=api-gateway:3000

# ---------- Host ports (first two are the public entry points) ----------
# api-gateway:  3000   frontend (nginx): 5173
# postgres:     5432   redis: 6379   kafka: 9092   minio API: 9000  minio console: 9001
# auth: 3001  user: 3002  group: 3003  delivery: 3005  presence: 3006  notification: 3007
# NOTE: chat-service (3004), media-service (3010) and websocket-gateway
# (3008/3009) intentionally publish NO host port so `docker compose up --scale`
# works without conflicts.
